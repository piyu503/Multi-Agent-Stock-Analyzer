# Indian Stock Research Platform - Environment Configuration

# Backend server
PORT=8000
HOST=127.0.0.1
DATABASE_URL=sqlite:///./stocks.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM Provider Configuration
# Option 1: Local Ollama (Heterogeneous Multi-Model Stack)
LLM_PROVIDER=ollama
LLM_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_TEMPERATURE=0.2

# Specialized Model Tier Dispatching:
# 1. Analyst Workhorse (Fundamental, Growth, Valuation, Bull/Bear, Trader)
LLM_MODEL_ANALYST=qwen2.5:7b
# 2. Factual Extractor & Classifier (Evidence Verification, News Stage 1, Sentiment)
LLM_MODEL_EXTRACTOR=granite3-dense:2b
# 3. Adversarial Reasoner & Challenger (Risk Stress-Test, PM Cross-Examination)
LLM_MODEL_REASONER=deepseek-r1:7b

# Fallback Primary Model (Used if specialized models are not pulled or fail)
LLM_MODEL=qwen2.5:7b

# Option 2: OpenAI / OpenRouter Unified Cloud
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_MODEL_ANALYST=qwen/qwen-2.5-72b-instruct
# LLM_MODEL_EXTRACTOR=ibm/granite-3-8b-instruct
# LLM_MODEL_REASONER=deepseek/deepseek-r1

# Option 3: Google Gemini (via OpenAI compatibility)
# LLM_PROVIDER=gemini
# LLM_API_KEY=AIzaSy...
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-1.5-flash

# Optional: Dhan API Pro Live Institutional Feed (Read-Only Market Data)
# Leave empty or omitted to automatically use free standard sources (Yahoo Finance, NSE Scraper, BSE Filings).
# When provided, automatically upgrades market data to live sub-second ticks, real-time VWAP, official NSE delivery %, and F&O buildup.
# DHAN_CLIENT_ID=1100000000
# DHAN_ACCESS_TOKEN=eyJ0eXAiOiJKV1QiLC...
